{
  "components": {
    "schemas": {
      "AdminSessionRequest": {
        "properties": {
          "pin": {
            "title": "Pin",
            "type": "string"
          }
        },
        "required": [
          "pin"
        ],
        "title": "AdminSessionRequest",
        "type": "object"
      },
      "AdminSessionResponse": {
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expires_in"
        ],
        "title": "AdminSessionResponse",
        "type": "object"
      },
      "BookingBatchRequest": {
        "properties": {
          "bookings": {
            "items": {
              "$ref": "#/components/schemas/BookingIn"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Bookings",
            "type": "array"
          }
        },
        "required": [
          "bookings"
        ],
        "title": "BookingBatchRequest",
        "type": "object"
      },
      "BookingBatchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BookingResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "BookingBatchResponse",
        "type": "object"
      },
      "BookingIn": {
        "description": "Range checks (quantity, price) happen per item in the route, not here.",
        "properties": {
          "booked_at": {
            "format": "date-time",
            "title": "Booked At",
            "type": "string"
          },
          "drink_id": {
            "title": "Drink Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "person_id": {
            "title": "Person Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "unit_price_cents": {
            "title": "Unit Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "person_id",
          "drink_id",
          "quantity",
          "unit_price_cents",
          "booked_at"
        ],
        "title": "BookingIn",
        "type": "object"
      },
      "BookingResult": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "unknown_person",
                  "unknown_drink",
                  "invalid_quantity",
                  "invalid_price",
                  "invalid_booked_at"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "conflict",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "BookingResult",
        "type": "object"
      },
      "CatalogResponse": {
        "properties": {
          "drinks": {
            "items": {
              "$ref": "#/components/schemas/DrinkOut"
            },
            "title": "Drinks",
            "type": "array"
          },
          "etag": {
            "title": "Etag",
            "type": "string"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupOut"
            },
            "title": "Groups",
            "type": "array"
          },
          "persons": {
            "items": {
              "$ref": "#/components/schemas/PersonOut"
            },
            "title": "Persons",
            "type": "array"
          },
          "price_tiers": {
            "items": {
              "$ref": "#/components/schemas/PriceTierOut"
            },
            "title": "Price Tiers",
            "type": "array"
          }
        },
        "required": [
          "price_tiers",
          "persons",
          "groups",
          "drinks",
          "etag"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "DrinkOut": {
        "properties": {
          "crate_size": {
            "title": "Crate Size",
            "type": "integer"
          },
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_hidden": {
            "title": "Is Hidden",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "prices": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Prices",
            "type": "object"
          },
          "sort_order": {
            "title": "Sort Order",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "group_id",
          "crate_size",
          "sort_order",
          "is_hidden",
          "is_active",
          "prices"
        ],
        "title": "DrinkOut",
        "type": "object"
      },
      "GroupOut": {
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sort_order": {
            "title": "Sort Order",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "sort_order",
          "color"
        ],
        "title": "GroupOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PersonOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_collective": {
            "title": "Is Collective",
            "type": "boolean"
          },
          "is_hidden": {
            "title": "Is Hidden",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_tier_id": {
            "title": "Price Tier Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "price_tier_id",
          "is_hidden",
          "is_collective",
          "is_active"
        ],
        "title": "PersonOut",
        "type": "object"
      },
      "PriceTierOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sort_order": {
            "title": "Sort Order",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "sort_order"
        ],
        "title": "PriceTierOut",
        "type": "object"
      },
      "TabsResponse": {
        "properties": {
          "period_started_at": {
            "format": "date-time",
            "title": "Period Started At",
            "type": "string"
          },
          "tabs": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Tabs",
            "type": "object"
          }
        },
        "required": [
          "period_started_at",
          "tabs"
        ],
        "title": "TabsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "bar-tab",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/ping": {
      "get": {
        "operationId": "admin_ping_api_v1_admin_ping_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-admin-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Admin Ping"
      }
    },
    "/api/v1/admin/session": {
      "post": {
        "operationId": "open_admin_session_api_v1_admin_session_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Open Admin Session"
      }
    },
    "/api/v1/bookings": {
      "post": {
        "operationId": "post_bookings_api_v1_bookings_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingBatchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Bookings"
      }
    },
    "/api/v1/catalog": {
      "get": {
        "operationId": "read_catalog_api_v1_catalog_get",
        "parameters": [
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Catalog"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/tabs": {
      "get": {
        "operationId": "get_tabs_api_v1_tabs_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TabsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Tabs"
      }
    }
  }
}
