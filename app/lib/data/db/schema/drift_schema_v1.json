    {
      "name": "catalog_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_cache\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"json\" TEXT NOT NULL, \"etag\" TEXT NOT NULL, \"saved_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "bookings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookings\" (\"id\" TEXT NOT NULL, \"person_id\" TEXT NOT NULL, \"drink_id\" TEXT NOT NULL, \"quantity\" INTEGER NOT NULL, \"unit_price_cents\" INTEGER NOT NULL, \"booked_at\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"included_in_tabs\" INTEGER NOT NULL DEFAULT 0 CHECK (\"included_in_tabs\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tabs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tabs\" (\"person_id\" TEXT NOT NULL, \"cents\" INTEGER NOT NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"person_id\"));"
        }
      ]
    },
