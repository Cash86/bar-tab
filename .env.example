# Copy to .env (never commit .env). All variables use the BARTAB_ prefix.

# Public base URL of the server
BARTAB_PUBLIC_URL=https://bar.example.org
# SQLite database file
BARTAB_DB_PATH=./data/bartab.db
# Directory for other persistent data
BARTAB_DATA_DIR=./data
# Secret for signing sessions, at least 32 characters (openssl rand -hex 32)
BARTAB_SECRET_KEY=change-me-change-me-change-me-change-me
# Comma-separated device keys for tablets, each at least 32 characters (openssl rand -hex 32)
BARTAB_DEVICE_KEYS=change-me-change-me-change-me-change-me
# Admin PIN (4-8 digits), used only to seed an empty database
BARTAB_INITIAL_ADMIN_PIN=1234
# Timezone for periods and reports
BARTAB_TZ=Europe/Berlin
# SMTP settings for monthly reports (optional)
BARTAB_SMTP_HOST=smtp.example.org
BARTAB_SMTP_PORT=587
BARTAB_SMTP_USER=bar@example.org
BARTAB_SMTP_PASSWORD=change-me
BARTAB_SMTP_FROM=bar@example.org
# Day of month (1-28) the monthly report is sent
BARTAB_MONTHLY_REPORT_DAY=1
# Time of day (HH:MM, local timezone) the monthly report is sent
BARTAB_MONTHLY_REPORT_TIME=08:00
